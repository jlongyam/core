{
  "name": "@jlongyam/core",
  "version": "1.0.1",
  "description": "Core JS Libarary",
  "keywords": [
    "js",
    "core"
  ],
  "author": "jlongyam",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlongyam/core.git"
  },
  "homepage": "https://github.com/jlongyam/core",
  "dependencies": {
    "@jlongyam/ansi": "^1.2.0",
    "@jlongyam/env": "^4.1.5"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.0",
    "@jlongyam/repo": "^2.1.2",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-buble": "^1.0.3",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@web/dev-server": "^0.4.6",
    "rollup": "^4.57.1",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "test:assert": "node test/tester/assert.test.js",
    "test:runner": "node test/tester/runner.test.js",
    "server": "web-dev-server",
    "types": "tsc",
    "build": "rollup -c",
    "test:assert:cjs": "node test/tester/assert.test.cjs",
    "changelog": "repo changelog"
  },
  "files": [
    "src",
    "test",
    "dist",
    "index.html"
  ],
  "exports": {
    ".": {
      "types": "./dist/core.d.mts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.cjs",
      "default": "./dist/core.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com/"
  }
}
