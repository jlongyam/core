{
  "name": "@jlbyte/tester",
  "version": "1.1.2",
  "description": "JS Tester library",
  "keywords": [
    "test",
    "tester",
    "assert",
    "test-runner"
  ],
  "homepage": "https://github.com/jlongyam/core",
  "repository": {
    "url": "https://github.com/jlongyam/core",
    "directory": "packages/tester"
  },
  "license": "MIT",
  "author": "jlongyam",
  "devDependencies": {
    "@jlbyte/js": "^1.0.0"
  },
  "dependencies": {
    "@jlbyte/ansi": "^1.2.2",
    "@jlbyte/env": "^1.1.1"
  },
  "main": "dist/tester.cjs",
  "module": "dist/tester.mjs",
  "jsdelivr": "dist/tester.js",
  "exports": {
    ".": {
      "types": "./dist/tester.d.mts",
      "import": "./dist/tester.mjs",
      "require": "./dist/tester.cjs"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "usage": "node usage/test.mjs",
    "build": "js build ./src/tester.mjs ./dist -e @jlbyte/ansi,@jlbyte/env -a ./src/tester.css -f es,cjs,iife -p ./package.json"
  }
}
