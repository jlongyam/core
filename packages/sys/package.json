{
  "name": "@jlbyte/sys",
  "version": "1.0.2",
  "description": "System tools",
  "keywords": [
    "system",
    "exec",
    "fs"
  ],
  "repository": {
    "url": "https://github.com/jlongyam/core",
    "directory": "packages/sys"
  },
  "license": "MIT",
  "author": "jlongyam",
  "dependencies": {
    "fs-jetpack": "^5.1.0"
  },
  "devDependencies": {
    "@jlbyte/tester": "^1.1.1",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/node": "^26.6.6",
    "rollup": "^4.66.0",
    "typescript": "^7.0.2"
  },
  "main": "./dist/sys.cjs",
  "module": "./dist/sys.mjs",
  "exports": {
    ".": {
      "types": "./dist/types/sys.d.mts",
      "import": "./dist/sys.mjs",
      "default": "./dist/sys.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist/"
  ],
  "scripts": {
    "test": "cd test && node fs.test.mjs",
    "build:rollup": "rollup --input=./src/sys.mjs --dir ./dist --format es --entryFileNames \"[name].mjs\" -p node-resolve -e child_process,fs-jetpack && rollup --input=./src/sys.mjs --dir ./dist --format cjs --entryFileNames \"[name].cjs\" -p node-resolve -e child_process,fs-jetpack",
    "build:types": "tsc --allowJs --declaration --emitDeclarationOnly --rootDir ./dist --outDir ./dist/types ./dist/sys.mjs",
    "build": "npm run build:rollup && npm run build:types"
  }
}
