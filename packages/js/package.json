{
  "name": "@jlbyte/js",
  "version": "1.0.0",
  "description": "JS build command line tool",
  "keywords": [
    "build",
    "js-build",
    "build-helper",
    "easy-build"
  ],
  "homepage": "https://github.com/jlongyam/core",
  "repository": {
    "url": "https://github.com/jlongyam/core",
    "directory": "packages/js"
  },
  "license": "MIT",
  "author": "jlongyam",
  "devDependencies": {
    "@jlbyte/tester": "^1.1.1"
  },
  "dependencies": {
    "@jlbyte/cmd": "^1.0.2",
    "@jlbyte/dialog": "^1.0.1",
    "@jlbyte/sys": "^1.0.2",
    "@rollup-extras/plugin-strip-comments": "^0.1.4",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/node": "^26.6.6",
    "rollup": "^4.67.4",
    "rollup-plugin-cleanup": "^3.2.1",
    "typescript": "^7.0.2"
  },
  "main": "dist/build.cjs",
  "module": "src/build.mjs",
  "exports": {
    ".": {
      "types": "./dist/build.d.mts",
      "import": "./src/build.mjs",
      "require": "./dist/build.cjs"
    }
  },
  "bin": {
    "js": "./src/cli.mjs"
  },
  "files": [
    "README.md",
    "LICENSE",
    "src",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test:prepare": "node test/prepare.test.mjs",
    "test:build": "node test/build.test.mjs",
    "test:cli": "node test/cli.test.mjs",
    "test": "npm run test:prepare && npm run test:build && npm run test:cli",
    "build:cjs": "rollup --input=./src/build.mjs --dir ./dist --format cjs --entryFileNames \"[name].cjs\" -p commonjs,node-resolve,@rollup-extras/plugin-strip-comments,rollup-plugin-cleanup -e @jlbyte/sys,path",
    "build:types": "tsc --allowJs --declaration --emitDeclarationOnly --rootDir ./src --outDir ./dist ./src/build.mjs --types node",
    "build": "npm run build:cjs && npm run build:types"
  }
}
