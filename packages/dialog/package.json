{
  "name": "@jlbyte/dialog",
  "version": "1.0.2",
  "description": "CLI dialog",
  "keywords": [
    "cli",
    "dialog",
    "prompt"
  ],
  "repository": {
    "url": "https://github.com/core",
    "directory": "packages/dialog"
  },
  "license": "MIT",
  "author": "jlongyam",
  "devDependencies": {
    "@jlbyte/js": "^1.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "usage": "node usage/quick.mjs",
    "build": "js build ./src/index.mjs ./dist -e @clack/prompts -p ./package.json"
  }
}
