  },
  "scripts": {
    "usage:env": "node usage/env.mjs",
    "usage:env:global": "node usage/env.global.mjs",
    "usage:env:runtime": "node usage/env.runtime.mjs",
    "usage:env:tty": "node usage/env.tty.mjs"
  }
