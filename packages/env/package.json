{
  "name": "@jlbyte/env",
  "version": "1.0.0",
  "description": "Basic environment detector and manipulator",
  "keywords": [
    "env",
    "environtment",
    "env-tools",
    "detect-env",
    "env-variable"
  ],
  "homepage": "https://github.com/jlongyam/core",
  "bugs": {
    "url": "https://github.com/jlongyam/core/issues"
  },
  "repository": {
