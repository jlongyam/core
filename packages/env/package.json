{
  "name": "@jlbyte/env",
  "version": "1.1.2",
  "description": "Basic environment detector",
  "keywords": [
    "env",
    "environtment",
    "env-tools",
    "detect-env",
    "env-variable",
    "env-config"
  ],
  "homepage": "https://github.com/jlongyam/core",
  "repository": {
    "url": "https://github.com/jlongyam/core",
    "directory": "packages/env"
  },
  "license": "MIT",
  "author": "jlongyam",
  "devDependencies": {
    "@jlbyte/js": "^1.0.0"
  },
  "dependencies": {
    "bowser": "^2.15.0"
  },
  "main": "dist/env.cjs",
  "module": "dist/env.mjs",
  "jsdelivr": "dist/env.js",
  "exports": {
    ".": {
      "types": "./dist/env.d.mts",
      "import": "./dist/env.mjs",
      "require": "./dist/env.cjs"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "usage": "node usage/env.mjs",
    "build": "js build ./src/env.mjs ./dist -f es,cjs,iife -e bowser -p ./package.json"
  }
}