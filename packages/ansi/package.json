{
  "name": "@jlbyte/ansi",
  "version": "1.1.0",
  "description": "ANSI Libarary",
  "keywords": [
    "ansi",
    "ansi-icon",
    "ansi-color",
    "ansi-html",
    "ansi-to-html"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlongyam/core.git",
    "directory": "packages/ansi"
  },
  "license": "MIT",
  "author": "jlongyam",
  "main": "src/index.mjs",
  "dependencies": {
    "boxen": "^9.0.0",
    "figlet": "^1.12.0"
  },
  "exports": {
    ".": {
      "import": "./src/index.mjs"
    },
    "./icon": {
      "import": "./src/icon.mjs"
    },
    "./code": {
      "import": "./src/code.mjs"
    },
    "./style": {
      "import": "./src/style.mjs"
    },
    "./color": {
      "import": "./src/color.mjs"
    },
    "./html": {
      "import": "./src/utils/ansiToHtml.mjs"
    }
  },
  "scripts": {
    "usage:icon": "node usage/icon.mjs",
    "usage:code": "node usage/code.mjs",
    "usage:style": "node usage/style.mjs",
    "usage:color": "node usage/color.mjs",
    "usage:html": "node usage/html.mjs",
    "usage:banner": "node usage/banner.mjs",
    "usage:box": "node usage/box.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "README.md",
    "LICENSE",
    "src",
    "usage"
  ]
}
