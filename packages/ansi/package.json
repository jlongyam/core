{
  "name": "@jlbyte/ansi",
  "version": "1.2.3",
  "description": "ANSI library collection",
  "keywords": [
    "ansi",
    "ansi-icon",
    "ansi-color",
    "ansi-html",
    "ansi-to-html"
  ],
  "repository": {
    "url": "https://github.com/jlongyam/core",
    "directory": "packages/ansi"
  },
  "license": "MIT",
  "author": "jlongyam",
  "devDependencies": {
    "@jlbyte/js": "^1.0.0"
  },
  "main": "dist/ansi.cjs",
  "module": "dist/ansi.mjs",
  "jsdelivr": "dist/ansi.js",
  "exports": {
    ".": {
      "types": "./dist/ansi.d.mts",
      "import": "./dist/ansi.mjs",
      "require": "./dist/ansi.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "scripts": {
    "build": "js build ./src/index.mjs ./dist -n ansi -f es,cjs,iife -p ./package.json"
  }
}
