{
  "name": "@jlbyte/ansi",
  "version": "1.2.2",
  "description": "ANSI library collection",
  "keywords": [
    "ansi",
    "ansi-icon",
    "ansi-color",
    "ansi-html",
    "ansi-to-html",
    "ascii"
  ],
  "repository": {
    "url": "https://github.com/jlongyam/core",
    "directory": "packages/ansi"
  },
  "license": "MIT",
  "author": "jlongyam",
  "devDependencies": {
    "@jlbyte/dev": "^1.0.0",
    "rollup": "^4.66.0",
    "typescript": "^7.0.2"
  },
  "main": "dist/ansi.cjs",
  "jsdelivr": "dist/ansi.js",
  "exports": {
    ".": {
      "import": "./dist/ansi.mjs",
      "types": "./dist/types/ansi.d.mts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "scripts": {
    "build:es": "rollup --input.ansi=./src/index.mjs --dir ./dist --format es --entryFileNames \"[name].mjs\"",
    "build:cjs": "rollup --input.ansi=./src/index.mjs --dir ./dist --format cjs --entryFileNames \"[name].cjs\"",
    "build:iife": "rollup --input.ansi=./src/index.mjs --dir ./dist --name ansi --format iife --entryFileNames \"[name].js\"",
    "build:all": "npm run build:es && npm run build:cjs && npm run build:iife",
    "build:types": "tsc --allowJs --declaration --emitDeclarationOnly --rootDir ./dist --outDir ./dist/types ./dist/ansi.mjs",
    "build": "npm run build:all && npm run build:types",
    "test": "dev build js ./src/index.mjs ./temp -n ansi -f es,cjs,iife"
  }
}
