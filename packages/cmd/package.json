{
  "name": "@jlbyte/cmd",
  "version": "1.0.0",
  "description": "CLI command builder",
  "keywords": [
    "cli",
    "command",
    "args",
    "parser",
    "cli-command",
    "arg-parser",
    "cli-builder",
    "cli-help"
  ],
  "repository": {
    "url": "https://github.com/jlongyam/core",
    "directory": "packages/cmd"
  },
  "license": "MIT",
  "author": "jlongyam",
  "devDependencies": {
    "@jlbyte/tester": "^1.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "rollup": "^4.66.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@jlbyte/ansi": "^1.2.1"
  },
  "main": "./dist/Cmd.cjs",
  "exports": {
    ".": {
      "import": "./dist/Cmd.mjs",
      "require": "./dist/Cmd.cjs",
      "types": "./dist/types/Cmd.d.ts"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist/",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "usage:quick": "node usage/quick.mjs",
    "usage:run": "node usage/run.mjs",
    "usage:parse": "node usage/parse.mjs",
    "usage:option": "node usage/option.mjs",
    "usage:log": "node usage/log.mjs",
    "build:rollup": "rollup --input=./src/Cmd.mjs --dir ./dist --format es --entryFileNames \"[name].mjs\" -p node-resolve -e @jlbyte/ansi && rollup --input=./src/Cmd.mjs --dir ./dist --format cjs --entryFileNames \"[name].cjs\" -p node-resolve -e @jlbyte/ansi",
    "build:types": "tsc --allowJs --declaration --emitDeclarationOnly --rootDir ./dist --outDir ./dist/types ./dist/Cmd.mjs",
    "build": "npm run build:rollup && npm run build:types",
    "test": "clear && node src/test.mjs"
  }
}
