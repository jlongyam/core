{
  "name": "@jlbyte/cmd",
  "version": "1.0.4",
  "description": "CLI command builder",
  "repository": {
    "url": "https://github.com/jlongyam/core",
    "directory": "packages/cmd"
  },
  "license": "MIT",
  "author": "jlongyam",
  "devDependencies": {
    "@jlbyte/js": "^1.0.2"
  },
  "dependencies": {
    "cac": "^7.1.0"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "js build ./src/index.mjs ./dist -e cac -p ./package.json"
  }
}
