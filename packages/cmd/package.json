{
  "name": "@jlbyte/cmd",
  "version": "1.0.1",
  "description": "CLI command builder",
  "keywords": [
    "cli",
    "command",
    "args",
    "parser",
    "cli-command",
    "arg-parser",
    "cli-builder",
    "cli-help"
  ],
  "repository": {
    "url": "https://github.com/jlongyam/core",
    "directory": "packages/cmd"
  },
  "license": "MIT",
  "author": "jlongyam",
  "devDependencies": {
    "@rollup-extras/plugin-strip-comments": "^0.1.4",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "cac": "^7.1.0",
    "rollup": "^4.66.0",
    "rollup-plugin-cleanup": "^3.2.1",
    "typescript": "^7.0.2"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "exports": {
    "types": "./dist/index.d.mts",
    "import": "./dist/index.mjs",
    "default": "./dist/index.cjs"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:es": "rollup --input=./src/index.mjs --dir ./dist --format es --entryFileNames \"[name].mjs\" -p commonjs,node-resolve,@rollup-extras/plugin-strip-comments,rollup-plugin-cleanup",
    "build:cjs": "rollup --input=./src/index.mjs --dir ./dist --format cjs --entryFileNames \"[name].cjs\" -p commonjs,node-resolve,@rollup-extras/plugin-strip-comments,rollup-plugin-cleanup",
    "build:rollup": "npm run build:es && npm run build:cjs",
    "build:types": "tsc --allowJs --declaration --emitDeclarationOnly --rootDir ./dist --outDir ./dist ./dist/index.mjs --types node",
    "build": "npm run build:rollup && npm run build:types"
  }
}
